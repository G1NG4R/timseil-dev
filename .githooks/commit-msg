#!/bin/sh
# Conventional Commits. The PR title becomes the commit on main (squash merge),
# but local messages are what release-please reads from the history later.
set -eu

msg_file=$1
subject=$(sed -n '1p' "$msg_file")

# Git's own machinery writes these; they are not ours to reformat.
case "$subject" in
  "Merge "* | "Revert "* | "fixup!"* | "squash!"* | "Reapply "*) exit 0 ;;
esac

# `style` IS IN THE LIST AND WAS NOT, WHICH STOPPED BEING COSMETIC IN H9c.
# CONTRIBUTING.md's type table and tools/release.sh:29 have both carried it since
# E5c — "docs chore ci test refactor style build revert  NO release" — and this
# file was the only one of the three that did not. It never showed, because the
# squash throws local subjects away. Now .github/workflows/pr-title.yml runs this
# same hook over the PULL REQUEST title, so a title the guide permits and the
# hook refuses is a merge nobody can complete. Two copies of a list, one stale —
# #241, again.
pattern='^(feat|fix|chore|docs|refactor|test|perf|style|build|ci|revert)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  echo "✗ Commit message is not a Conventional Commit."
  echo ""
  echo "  got:      $subject"
  echo "  expected: type(scope)?: description"
  echo "  types:    feat fix chore docs refactor test perf style build ci revert"
  echo "  example:  feat(api): add training endpoint"
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "✗ Subject is ${#subject} characters, limit is 72."
  echo "  Put the detail in the body, one blank line below."
  exit 1
fi
