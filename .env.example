# Local development only. Copy to .env, which git ignores:
#
#     cp .env.example .env && make dev
#
# Nothing in this file is a secret, and nothing that is a secret ever belongs
# in a file in this repository. Production values are runtime environment
# variables from Dokploy — never a build arg (that bakes them into the image
# layers) and never behind NEXT_PUBLIC_ (that prefix ships them to the browser).

# ------------------------------------------------------------------- postgres
# Read by the db container, and only on the very first start: these values are
# baked into the data directory by initdb. Changing them later does nothing
# until the volume is gone — `make dev-reset`.
POSTGRES_DB=timseil
# The bootstrap superuser, and nothing else. It runs initdb, creates the two
# real roles, and is then only good for a psql session. The name says so.
POSTGRES_USER=timseil_boot
POSTGRES_PASSWORD=dev_only_not_a_secret

# ---------------------------------------------------------------- db roles
# Two roles, not one. timseil_migrate owns the schema and is the only role that
# may run DDL; timseil_app may only read and write rows. The reason is concrete:
# an SQL injection in the API then cannot drop a table. Least privilege at the
# point where it is cheapest and most effective. ADR 0011.
#
# Read by ops/postgres/initdb/10-roles.sh, which runs ONLY when the data
# directory is created. Changing anything here needs `make dev-reset` — on an
# existing volume it has no effect at all, and `make migrate` then fails with
# "role does not exist".
MIGRATE_DB_PASSWORD=dev_only_not_a_secret
APP_DB_PASSWORD=dev_only_not_a_secret

# ------------------------------------------------------------------------ api
# Read by the api container. The host is the compose service name: Postgres has
# no published port, so it is reachable inside the docker network and nowhere
# else — not from your machine, not from your LAN.
#
# This is the ONLY variable the api cannot start without. The api also refuses
# a DSN that connects as timseil_migrate: the long-lived process may not carry
# DDL credentials, or the role split is decoration (ADR 0011).
DATABASE_URL=postgres://timseil_app:dev_only_not_a_secret@db:5432/timseil?sslmode=disable

# ------------------------------------------------------------- api, tunables
# Everything below has a default in api/internal/config. Leave a line empty and
# that default applies; the values here are the defaults, written out so the
# knobs are visible rather than discoverable. Wrong values stop the start with
# every problem named at once, not one per restart. ADR 0014.

# debug · info · warn · error
LOG_LEVEL=info

# How long a handler may run, and how long a stopping server waits for what is
# still in flight. The first MUST be shorter than the second — otherwise a
# request is still legally running when the grace period ends, and the shutdown
# cuts exactly the request this phase promises not to cut. compose.dev.yaml
# raises stop_grace_period to match; Docker would otherwise SIGKILL after 10s.
REQUEST_TIMEOUT=15s
SHUTDOWN_GRACE=20s

# The pool. Ten is a ceiling, not a target: the read paths are indexed single
# queries, and a larger pool only moves the queue from the application into
# Postgres. During a zero-downtime deploy two instances run at once, so the peak
# is 2 × DB_MAX_CONNS against max_connections = 100.
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# The three Postgres session timeouts, set on every connection at startup.
# statement: no read path here needs five seconds, so five seconds is a bug that
# must not hold a pool slot. lock: the app role does no DDL and can only wait on
# a migration in flight. idle-in-transaction: far above any legitimate
# transaction here, tight enough that a forgotten one cannot block migrate.
DB_STATEMENT_TIMEOUT=5s
DB_LOCK_TIMEOUT=2s
DB_IDLE_TX_TIMEOUT=10s

# Token bucket per client: RATE_LIMIT_BURST tokens to spend at once,
# RATE_LIMIT_RPM added back over a minute. The stricter contact limit
# (3 per IP per 10 minutes) is a second limiter in front of POST /api/contact
# and is NOT configurable — it is a promise the public documentation makes, so
# it lives in a commit. internal/contact holds the number.
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=60

# Which peers may set X-Forwarded-For. Empty means believe nobody, and that is
# the default in code on purpose: a program that assumes a proxy in front of it
# lets any client pick its own identity for the rate limiter the day it is
# reachable directly. compose.dev.yaml fills in the docker networks; in
# production Dokploy does. ADR 0015.
TRUSTED_PROXY_CIDRS=

# Not used by the read endpoints — those answer any origin, because an API whose
# argument is "check it yourself" has to be callable from a browser too. It is
# the write path that consults it: POST /api/contact refuses a submission whose
# Origin is present and not on this list, and the CORS layer echoes the origin
# back so a browser may read the receipt. A request with NO Origin still gets
# through — curl and CI are legitimate callers of a public API.
CORS_ALLOWED_ORIGINS=https://timseil.dev,https://www.timseil.dev,http://localhost:3000

# Which system /api/health reports operational numbers for. deploys and
# metric_snapshots hang off a system and OpsSummary carries one set of values,
# so the system is named rather than guessed.
SITE_SYSTEM_SLUG=timseil-dev

# ------------------------------------------------------------------- github
# The contribution graph on the homepage. GitHub's REST API does not serve the
# contribution calendar at all — the only way to it is GraphQL, and that needs a
# token even for public data. Handbook ch. 15.
#
# GITHUB_TOKEN is the one real secret in local development, and the only variable
# besides DATABASE_URL that the api refuses to start without. It is deliberately
# EMPTY here: this file is committed, and a token in it would be a token in the
# repository. Make your own and put it in .env, which git ignores:
#
#     github.com/settings/tokens  →  scope read:user, and nothing else
#
# read:user is enough for someone else's public calendar as well as your own. A
# token with more scope is a bigger loss if it leaks, and this one is handed to a
# process that is reachable from the internet.
#
# In production it comes from Dokploy as a runtime variable. Never a build arg —
# that bakes it into the image layers — and never behind NEXT_PUBLIC_, which
# would ship it to every browser that opens the page.
GITHUB_TOKEN=

# Whose calendar. Also the key of the cached row, so changing it leaves the old
# row in contributions_cache behind; harmless, and docs/runbooks/api.md says so
# in case the count ever looks wrong.
GITHUB_LOGIN=G1NG4R

# ------------------------------------------------------- contact form & mail
# POST /api/contact is the only unauthenticated write path on the site and its
# only conversion point. Handbook ch. 16.
#
# MAIL_TRANSPORT picks how a message leaves: `smtp` sends it through OVH, `log`
# builds it in full and writes it to a log line instead. The default is `smtp`,
# and the direction matters — a default that logs would turn one forgotten
# variable in Dokploy into a site that answers every submission with 202 and
# delivers nothing, which is the worst failure this endpoint has because it
# looks exactly like success.
#
# `log` is the development setting and compose.dev.yaml passes it, because the
# OVH mailbox and the DNS records are phase L1 and L1 comes after stage D. Until
# then there is nothing to send to. The api warns at startup while it is on, and
# it puts a visitor's address in a log line — fine on your machine, not fine in
# Loki.
MAIL_TRANSPORT=log

# The mailbox, required only when MAIL_TRANSPORT=smtp. The username is the FULL
# address, which is also what OVH MX Plan requires the From header to be — so
# there is no MAIL_FROM variable here on purpose. A separate one could only ever
# be set wrong, and the relay would reject it after the password had already
# crossed the wire. The visitor's address goes in Reply-To and nowhere else.
#
# SMTP_PASSWORD is a real secret and is EMPTY here for the same reason
# GITHUB_TOKEN is: this file is committed. In production both come from Dokploy
# as runtime variables — never a build arg, never behind NEXT_PUBLIC_.
SMTP_USERNAME=contact@timseil.dev
SMTP_PASSWORD=

# Where the messages land. A separate variable from SMTP_USERNAME because the
# account that sends and the inbox that reads do not have to be the same one.
MAIL_TO=contact@timseil.dev

# The key for the stored ip_hash, and required whatever the transport — the hash
# is written on every submission.
#
# A different problem from the rate limiter's key, which is random per process
# and never configured (ADR 0015): that one labels a bucket forgotten after ten
# minutes, this one is written to a table that outlives every restart. IPv4 is
# 2^32 addresses, so an unpeppered SHA-256 is a spelling of the address rather
# than a replacement for it — a dictionary of the whole space is minutes of work.
#
# EMPTY here, and the api will not start without it. Make your own:
#
#     openssl rand -hex 32
#
# Rotating it orphans every hash written before the change: the rate-limit floor
# stops recognising an address it has already seen. That is also the only way to
# forget everybody at once. docs/runbooks/api.md says so.
CONTACT_IP_PEPPER=

# -------------------------------------------------------- internal endpoints
# The two bearer tokens for POST /api/internal/probe and POST
# /api/internal/deploy. Neither endpoint appears in /api/docs, and from outside
# the reverse proxy both will answer 404 once L3 lands — the token is one layer,
# the proxy is the other.
#
# TWO variables and not one, deliberately. The prober (F4) and the deploy
# pipeline (E4) are different callers, and the two writes are worth different
# amounts: an invented uptime row is one cell in a grid of ninety-one, an
# invented deploy row is the number the case study points at when it says the
# deploy duration is measured rather than claimed. One leaked token must not buy
# both, and rotating one must not mean rotating the other.
#
# EMPTY here, and the api will not start without them. At least 32 characters:
#
#     openssl rand -hex 32
#
# Never a build arg and never behind NEXT_PUBLIC_ — the first puts a secret in
# an image layer, the second sends it to the browser.
INTERNAL_PROBE_TOKEN=
INTERNAL_DEPLOY_TOKEN=

# ------------------------------------------------------------------ migrate
# Read by the migrate service only. The api container never sees this one; if it
# did, the long-lived process would be carrying DDL credentials and the role
# split would be decoration.
MIGRATE_DATABASE_URL=postgres://timseil_migrate:dev_only_not_a_secret@db:5432/timseil?sslmode=disable

# Where `make check-db` cycles the migrations, so the development database is
# not wiped every time the schema is proven. Created by the initdb script.
TEST_DATABASE_URL=postgres://timseil_migrate:dev_only_not_a_secret@db:5432/timseil_test?sslmode=disable
TEST_APP_DATABASE_URL=postgres://timseil_app:dev_only_not_a_secret@db:5432/timseil_test?sslmode=disable

# ---------------------------------------------------------------- host ports
# Only where the two services show up on YOUR machine, bound to 127.0.0.1 so
# nothing leaves it. Inside the docker network they are always api:8080 and
# web:3000, whatever you put here.
API_PORT=8080
WEB_PORT=3000

# ------------------------------------------------------------------------ web
# How the web container reaches the api container, server side. The browser
# never uses this value — it calls /api. The API client in G4 consumes it.
API_INTERNAL_URL=http://api:8080
